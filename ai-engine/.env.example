# CareOps AI Engine - Environment Configuration
# Phase 1: Backend Foundation

APP_NAME=careops-ai-engine
APP_VERSION=1.0.0
API_PREFIX=/api/v1
MAX_TRANSCRIPT_LENGTH=50000
ALLOWED_LANGUAGES=["en", "hi", "kn"]
LOG_LEVEL=INFO
DEBUG=false

# Server Configuration
HOST=127.0.0.1
PORT=8000

# CORS Origins (Frontend connection)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
