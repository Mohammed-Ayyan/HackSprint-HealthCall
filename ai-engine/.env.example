# CareOps AI Engine - Environment Configuration
# Phase 1 & 2: Backend Foundation & Audio Transcription

APP_NAME=careops-ai-engine
APP_VERSION=1.0.0
API_PREFIX=/api/v1
MAX_TRANSCRIPT_LENGTH=50000
ALLOWED_LANGUAGES=["en", "hi", "kn"]
LOG_LEVEL=INFO
DEBUG=false

# Server Configuration
HOST=127.0.0.1
PORT=8000

# CORS Origins (Frontend connection)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Phase 2: Whisper Audio Transcription Engine
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_UPLOAD_SIZE_MB=25
ALLOWED_AUDIO_EXTENSIONS=[".wav", ".mp3", ".m4a", ".flac", ".ogg"]
SUPPORTED_AUDIO_LANGUAGES=["en", "hi", "kn"]
